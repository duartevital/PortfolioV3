---
const links = [
  { href: '/', label: 'Home' },
  { href: '/photography', label: 'Photography' },
  { href: '/contact', label: 'Contact' },
];

// Astro's static build emits directory-style URLs (e.g. /about/), so strip
// any trailing slash before comparing against the un-slashed hrefs below.
const currentPath =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : Astro.url.pathname;

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-nav">
  <a href="/" class="brand">Duarte Vital</a>
  <nav>
    {links.map((link) => (
      <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
        {link.label}
      </a>
    ))}
    <button type="button" class="theme-toggle" aria-label="Toggle light and dark mode" title="Toggle theme">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }
</script>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .brand {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .theme-toggle {
    display: inline-flex;
    padding: 0.25rem;
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .icon-moon {
    display: inline;
  }

  .nav-link {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .site-nav {
      justify-content: center;
      text-align: center;
      padding: 1.25rem 1rem;
    }

    nav {
      justify-content: center;
      gap: 0.5rem 1rem;
    }
  }
</style>
