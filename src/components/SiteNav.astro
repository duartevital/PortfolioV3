---
const links = [
  { href: '/', label: 'Home' },
  { href: '/photography', label: 'Photography' },
  { href: '/contact', label: 'Contact' },
];

// Astro's static build emits directory-style URLs (e.g. /about/), so strip
// any trailing slash before comparing against the un-slashed hrefs below.
const currentPath =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : Astro.url.pathname;

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-nav">
  <a href="/" class="brand">Duarte Vital</a>
  <nav>
    {links.map((link) => (
      <a href={link.href} class:list={['nav-link', { active: isActive(link.href) }]}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .brand {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .nav-link {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .site-nav {
      justify-content: center;
      text-align: center;
      padding: 1.25rem 1rem;
    }

    nav {
      justify-content: center;
      gap: 0.5rem 1rem;
    }
  }
</style>
