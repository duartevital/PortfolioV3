---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE } from '../lib/cv';
---

<BaseLayout title="Contact — Duarte Vital" description="Get in touch with Duarte Vital, Software Engineer in Utrecht.">
	<main class="contact">
		<h1>Contact</h1>
		<p>For job opportunities, collaborations, photography, or just to say hello:</p>
		<a class="email" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
		<a class="linkedin" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
	</main>
</BaseLayout>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 480px;
		margin: 0 auto;
		padding: 4rem 1.5rem;
		text-align: center;
	}

	h1 {
		margin-bottom: 1rem;
	}

	p {
		color: var(--color-muted);
		margin-bottom: 1.5rem;
	}

	.email {
		font-size: 1.25rem;
		color: var(--color-accent);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.linkedin {
		margin-top: 1rem;
		color: var(--color-muted);
		text-decoration: none;
	}

	.email:hover,
	.linkedin:hover {
		color: var(--color-accent-dim);
	}
</style>
