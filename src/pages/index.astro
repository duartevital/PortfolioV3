---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.vue';
import { GENRES, GENRE_SLUGS } from '../lib/categories';
---

<BaseLayout
	title="Vital Photography"
	description="Vital Photography — a travel, dog and wedding photography portfolio."
>
	<h1 class="site-title">Vital Photography</h1>
	<Gallery highlightsPerGenre={4} client:load />

	<section class="genre-links">
		{GENRE_SLUGS.map((genre) => (
			<a href={`/${genre}`} class="genre-card">
				<span class="genre-card-label">{GENRES[genre].label}</span>
				<span class="genre-card-cta">View gallery →</span>
			</a>
		))}
	</section>
</BaseLayout>

<style>
	.site-title {
		text-align: center;
		padding: 2rem 1.5rem 0;
		margin: 0;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.genre-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem 3rem;
	}

	.genre-card {
		flex: 1 1 200px;
		max-width: 300px;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-surface);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.genre-card:hover {
		border-color: var(--color-accent-dim);
	}

	.genre-card-label {
		color: var(--color-text);
		font-weight: 600;
	}

	.genre-card-cta {
		color: var(--color-accent);
		font-size: 0.85rem;
	}
</style>
